# 이 파일을 복사해 backend/.env 를 만들고 값을 채운다. (.env 는 저장소에 올라가지 않는다)
# 팀에서 쓰는 값은 팀장에게 따로(비공개로) 받는다.

# DB 비밀번호. DB를 처음 만들 때 이 값으로 정해진다 (나중에 바꾸면 DB를 다시 만들어야 한다).
POSTGRES_PASSWORD=

# 모든 로그인 계정의 비밀번호.
APP_TEST_PASSWORD=

# 로그인 계정: 아이디:DB이름:demo|dev[:doctor] 를 쉼표로 이어 쓴다.
#   demo   = 시연 DB (가상 자료가 다 들어 있음)
#   dev    = 개발 DB (예시만)
#   doctor = 의료진 협진 포털(/doctor) 전용 계정
# 예) 아이디1:byeoljari_dev:dev,아이디2:byeoljari_demo:demo,아이디3:byeoljari_demo:demo:doctor
APP_ACCOUNTS=

# 패스키를 쓸 주소 (보통 그대로 둔다).
# PASSKEY_ORIGIN=http://localhost:8093
